# =============================================================================
# .env.example — Environment variable template for the Agentic Cloud Assistant
#
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# .env is listed in .gitignore and must never be committed to source control.
# =============================================================================


# -----------------------------------------------------------------------------
# LLM API Keys
# At least one is required. The frontend lets you choose which model to use.
# -----------------------------------------------------------------------------

# Groq API key — used when model is set to "groq" in the frontend.
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Ollama base URL — used when model is set to "ollama" in the frontend.
# Leave blank to default to http://localhost:11434
# Local development (without Docker):
# OLLAMA_BASE_URL=http://localhost:11434
# Docker (Ollama running natively on the host):
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Anthropic API key — used when model is set to "anthropic" in the frontend.
# Get a key at https://console.anthropic.com
# Also required for the /agent/run endpoint (agentic loop uses claude-opus-4-5).
ANTHROPIC_API_KEY=your_anthropic_api_key_here


# -----------------------------------------------------------------------------
# AWS Configuration (server-side defaults)
# All AWS credentials are server-side; browser requests never supply keys.
# For production use, prefer IAM roles over hardcoded keys.
# -----------------------------------------------------------------------------

# Default AWS region for boto3 calls that do not receive an explicit region.
# The authenticated model/region settings can select the operation region.
AWS_DEFAULT_REGION=us-east-1

# AWS access key ID — leave blank if using IAM instance roles or aws configure.
# AWS_ACCESS_KEY_ID=your_aws_access_key_id_here

# AWS secret access key — leave blank if using IAM instance roles or aws configure.
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
# Temporary credentials also require their session token; it is never sent to the browser.
# AWS_SESSION_TOKEN=your_temporary_session_token
# Optional account pin: reject any server credentials resolving to another account.
# ACA_AWS_ACCOUNT_ID=123456789012


# -----------------------------------------------------------------------------
# Optional remote S3 state backend (native S3 lockfile; no DynamoDB table).
# Configure an EXISTING versioned/encrypted bucket; this application does not create it.
# Set the same bucket/region in backend/runner/config.json state_backend.
# Execution IAM needs ListBucket; GetObject/PutObject on state; and
# GetObject/PutObject/DeleteObject on the matching .tflock object. See README.
# TF_STATE_BUCKET=my-app-tfstate
# TF_STATE_REGION=us-east-1

# Isolated execution is required even for local development; no host Terraform fallback.
# Compose supplies these values and mounts the private runner credential volume.
# ACA_RUNNER_URL=http://localhost:8090
# ACA_RUNNER_TOKEN_FILE=/secure/local/path/to/runner-token

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

# Generate a salted hash interactively: cd backend && python -m services.auth hash-password
# No default password exists. HTTP operations stay locked until configured.
ACA_OPERATOR_USERNAME=admin
ACA_OPERATOR_PASSWORD_HASH=
# Exact browser origins, comma-separated. Set your HTTPS origin in deployments.
ACA_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:8000
# false is for local HTTP only; use true behind HTTPS (the code default is true).
ACA_COOKIE_SECURE=false
ACA_SESSION_SECONDS=28800
# Optional external MCP/automation access. Generate with: python -m services.auth generate-token
# Store only its SHA-256 digest here; keep the raw token in the client's secret store.
ACA_MCP_TOKEN_SHA256=

# Set to "true" to enable FastAPI debug mode (auto-reload, verbose errors).
# Set to "false" or remove this line in any internet-facing deployment.
DEBUG=true

# Durable local storage. Docker Compose sets these paths explicitly.
# Defaults outside Docker: backend/data and backend/chroma_db.
# ACA_DATA_DIR=/absolute/path/to/data
# CHROMA_DB_PATH=/absolute/path/to/chroma_db
# Optional one-time migration sources (see README before replacing old containers).
# ACA_LEGACY_EXECUTION_LOG=/app/data/legacy/execution_log.json
# ACA_LEGACY_CHROMA_PATH=/app/data/legacy/chroma_db
