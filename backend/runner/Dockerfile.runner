FROM docker:29.9.3-cli AS docker-cli

FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
WORKDIR /opt/aca
COPY requirements-runner.txt .
RUN pip install --no-cache-dir --require-hashes -r requirements-runner.txt
COPY runner ./runner
COPY services/aws_terraform_guard.py services/aws_connection.py ./services/
RUN groupadd -g 10001 aca && useradd -u 10001 -g 10001 -M aca \
    && mkdir /workspaces /control /credentials && chown 10001:10001 /workspaces /control /credentials
USER 10001:10001
EXPOSE 8090
CMD ["python", "-m", "runner.broker"]
